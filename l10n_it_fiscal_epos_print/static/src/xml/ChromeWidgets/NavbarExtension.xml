<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <!-- Add EpsonEPOSButton to Chrome status buttons -->
    <t
        t-name="l10n_it_fiscal_epos_print.NavbarButtons"
        t-inherit="point_of_sale.Chrome"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[@class='status-buttons']" position="inside">
            <EpsonEPOSButton />
            <EpsonFP81IIComponent />
        </xpath>
    </t>

</templates>
